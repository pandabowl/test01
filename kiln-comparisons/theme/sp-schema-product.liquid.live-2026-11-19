{%- if template.name == 'product' -%}
{%- comment -%}
  The only Product structured data on the page. Booster SEO's Product block is filtered out by
  snippets/sp-booster-seo-filter.liquid so search engines and AI agents see one product, not two.
  Shipping is not marked up here: rates vary by weight, so they come from Merchant Center / Search Console.
{%- endcomment -%}
{%- liquid
  assign sd_url = shop.url | append: product.url
  assign sd_variant = product.selected_or_first_available_variant
  assign sd_house_brand = false
  assign sd_vendor_handle = product.vendor | handle
  if sd_vendor_handle contains 'sheffield-pottery'
    assign sd_house_brand = true
  endif
  assign sd_description = product.description | replace: '</p>', '</p> ' | replace: '<br>', ' ' | replace: '<br/>', ' ' | replace: '<br />', ' ' | replace: '</li>', '</li> ' | strip_html
  assign sd_description = sd_description | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&rsquo;', '’' | replace: '&lsquo;', '‘' | replace: '&rdquo;', '”' | replace: '&ldquo;', '“' | replace: '&ndash;', '–' | replace: '&mdash;', '—' | replace: '&deg;', '°' | strip | truncate: 5000
  assign sd_rating_count = product.metafields.yotpo.reviews_count.value | plus: 0
  assign sd_rating_value = product.metafields.yotpo.reviews_average.value | plus: 0
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ sd_url | append: '#product' | json }},
  "url": {{ sd_url | json }},
  "name": {{ product.title | strip_html | json }},
  "description": {{ sd_description | json }},
  "image": [
    {%- for image in product.images limit: 5 -%}
      {{ image | image_url: width: 2000 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  {%- if product.category.name != blank %}
  "category": {{ product.category.name | json }},
  {%- endif %}
  {%- if product.has_only_default_variant %}
    {%- if sd_variant.sku != blank %}
  "sku": {{ sd_variant.sku | json }},
      {%- if sd_house_brand %}
  "mpn": {{ sd_variant.sku | json }},
      {%- endif %}
    {%- endif %}
    {%- capture sd_gtin -%}{% render 'sp-gtin', code: sd_variant.barcode %}{%- endcapture -%}
    {%- if sd_gtin != blank %}
  "gtin": {{ sd_gtin | json }},
    {%- endif %}
  {%- endif %}
  "offers": [
    {%- for variant in product.variants %}
    {
      "@type": "Offer",
      "url": {{ shop.url | append: variant.url | json }},
      {%- unless product.has_only_default_variant %}
      "name": {{ variant.title | json }},
      {%- endunless %}
      {%- if variant.sku != blank %}
      "sku": {{ variant.sku | json }},
      {%- endif %}
      {%- capture sd_gtin -%}{% render 'sp-gtin', code: variant.barcode %}{%- endcapture -%}
      {%- if sd_gtin != blank %}
      "gtin": {{ sd_gtin | json }},
      {%- endif %}
      "price": "{{ variant.price | money_without_currency | remove: ',' }}",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition",
      "seller": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "US",
        "returnPolicyCountry": "US",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 30,
        "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility",
        "returnMethod": "https://schema.org/ReturnByMail",
        "merchantReturnLink": {{ shop.url | append: '/policies/refund-policy' | json }}
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
  {%- if sd_rating_count > 0 and sd_rating_value > 0 %},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ sd_rating_value | round: 2 }},
    "reviewCount": {{ sd_rating_count }},
    "bestRating": 5,
    "worstRating": 1
  }
  {%- endif %}
}
</script>
{%- endif -%}
