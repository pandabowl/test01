{%- comment -%}
  "See full specifications" button at the top of the Product Description tab
  (rendered by sections/hk-tab-section.liquid when the Specifications tab shows).
  Clicking it opens the Specifications tab and scrolls to it. A link to the
  product URL with #specifications does the same on page load.
  Also marks this product's own row in any comparison table (.spc-current).
  See kiln-comparisons/SHARED-BLOCKS.md.
{%- endcomment -%}
<p class="sp-spec-jump-wrap">
  <a class="sp-spec-jump" href="#specifications" data-sp-spec-jump>
    <span class="sp-spec-jump__icon" aria-hidden="true">&#9776;</span>
    <span>See full specifications</span>
    <span class="sp-spec-jump__arrow" aria-hidden="true">&darr;</span>
  </a>
</p>
<style>
  .rte .sp-spec-jump-wrap { margin: 0 0 18px; }
  .rte a.sp-spec-jump {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 18px; border: 2px solid #1f2a6b; border-radius: 6px;
    background: #1f2a6b; color: #fff; font-weight: 700; font-size: 15px;
    line-height: 1.2; text-decoration: none;
  }
  .rte a.sp-spec-jump:hover, .rte a.sp-spec-jump:focus { background: #fff; color: #1f2a6b; }
  .sp-spec-jump__icon { font-size: 16px; }
  .sp-specs-tab .sp-compare--product { margin-top: 28px; }
  .sp-specs-tab .hk-specs-table-wrap + .sp-compare--product { border-top: 1px solid #d9dce8; padding-top: 24px; }
  .sp-compare tbody tr.spc-current td { background: #fff6e5 !important; }
  .sp-compare tbody tr.spc-current td.spc-model { box-shadow: inset 4px 0 0 #c8452d; }
</style>
<script>
  (function () {
    function specLi() {
      var a = document.querySelector('#tabs-nav a[href^="#tab-specifications"]');
      return a ? a.closest('li') : null;
    }
    function openSpecs(scroll) {
      var li = specLi();
      if (!li) return;
      li.click();
      if (!scroll) return;
      var nav = li.closest('.tabs-wrap') || li;
      var top = nav.getBoundingClientRect().top + window.pageYOffset - 140;
      window.scrollTo({ top: top, behavior: 'smooth' });
    }
    document.addEventListener('click', function (e) {
      var a = e.target.closest('[data-sp-spec-jump]');
      if (!a) return;
      e.preventDefault();
      openSpecs(true);
    });
    function init() {
      var here = window.location.pathname.replace(/\/$/, '');
      document.querySelectorAll('.sp-compare--product td.spc-model a').forEach(function (a) {
        var p = (a.getAttribute('href') || '').split(/[?#]/)[0].replace(/\/$/, '');
        if (p && here.slice(-p.length) === p) {
          var tr = a.closest('tr');
          if (tr) tr.classList.add('spc-current');
        }
      });
      if (window.location.hash === '#specifications') setTimeout(function () { openSpecs(true); }, 300);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
