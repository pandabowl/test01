    background-image: radial-gradient(circle at 20px 30px, rgba(255,255,255,.85) 1.5px, rgba(255,255,255,0) 3px), radial-gradient(circle at 80px 120px, rgba(255,255,255,.65) 1px, rgba(255,255,255,0) 2.5px), radial-gradient(circle at 150px 60px, rgba(255,255,255,.8) 2px, rgba(255,255,255,0) 3.5px), radial-gradient(circle at 170px 170px, rgba(255,255,255,.6) 1px, rgba(255,255,255,0) 2.5px), radial-gradient(circle at 45px 180px, rgba(255,255,255,.75) 1.5px, rgba(255,255,255,0) 3px), radial-gradient(circle at 110px 15px, rgba(255,255,255,.65) 1px, rgba(255,255,255,0) 2.5px); }
