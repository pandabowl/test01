  @keyframes shimpo-snow-a { to { transform: translateY(260px); } }
  @keyframes shimpo-snow-b { to { transform: translateY(420px); } }
  @keyframes shimpo-snow-c { to { transform: translateY(200px); } }
  @keyframes shimpo-spin { to { transform: rotate(360deg); } }
  @keyframes shimpo-twinkle { from { opacity: .25; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .shimpo-hero__snow::before, .shimpo-hero__snow::after, .shimpo-hero__dots::before, .shimpo-hero__deco, .shimpo-hero__lights::after { animation: none; } .shimpo-hero__btn { transition: none; } }

  @media (max-width: 719px) {
    .shimpo-hero { padding-top: 42px; }
    .shimpo-hero__title { font-size: clamp(24px, 6.6vw, 30px); }
    .shimpo-hero__inner { grid-template-columns: minmax(0, 1fr); grid-template-areas: "copy" "media" "cta"; row-gap: 16px; }
    .shimpo-hero__media { margin: 0 24% 3% 0; }
    .shimpo-hero__cards { right: -30%; bottom: auto; top: -10%; width: 38%; flex-direction: column; }
    .shimpo-gc { margin: 0 0 -6%; }
    .shimpo-hero__cta { flex-direction: column; align-items: stretch; text-align: center; }
    .shimpo-hero__btn { justify-content: center; }
    .shimpo-hero__dates { align-self: center; padding: 0; border: 0; background: none; font-size: 14px; }
    .shimpo-hero__eyebrow { font-size: 11.5px; letter-spacing: .09em; margin-bottom: 6px; }
    .shimpo-hero__text { font-size: 14.5px; }
    .shimpo-hero__cta { gap: 8px; }
    .shimpo-hero__deco--b { top: auto; bottom: 64px; right: auto; left: 5%; width: 54px; }
    .shimpo-hero__deco--d { display: none; }
  }
</style>

<section class="shimpo-hero" aria-labelledby="shimpo-hero-title">
  <span class="shimpo-hero__deco shimpo-hero__deco--a" aria-hidden="true"></span>
  <span class="shimpo-hero__deco shimpo-hero__deco--c" aria-hidden="true"></span>
  <span class="shimpo-hero__deco shimpo-hero__deco--d" aria-hidden="true"></span>
  <span class="shimpo-hero__dots" aria-hidden="true"></span>
  <span class="shimpo-hero__snow" aria-hidden="true"></span>
  <span class="shimpo-hero__deco shimpo-hero__deco--b" aria-hidden="true"></span>
  <span class="shimpo-hero__lights" aria-hidden="true"></span>
  <div class="shimpo-hero__inner">
    <div class="shimpo-hero__copy">
      <p class="shimpo-hero__eyebrow">{{ eyebrow }}</p>
      <h2 class="shimpo-hero__title" id="shimpo-hero-title">Get a <span>$40</span> or <span>$30</span> gift card</h2>
      <p class="shimpo-hero__text">
        <strong>$40</strong> Sheffield Pottery gift card with a Shimpo <span class="nw">RK-Whisper</span> or <span class="nw">VL-Whisper</span>.
        <strong>$30</strong> with a <span class="nw">VL-Lite</span>.
      </p>
    </div>

    <div class="shimpo-hero__media">
      <ul class="shimpo-hero__wheels">
        {%- for handle in wheel_handles -%}
          {%- assign wheel = all_products[handle] -%}
          {%- if wheel.featured_image -%}
            <li>
              <a href="{{ wheel.url }}">
                {{ wheel.featured_image | image_url: width: 300 | image_tag:
                  widths: '150, 220, 300',
                  sizes: '(max-width: 719px) 26vw, 14vw',
                  alt: wheel.title,
                  loading: 'eager' }}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="shimpo-hero__cards" aria-hidden="true">
        <div class="shimpo-gc"><span class="shimpo-gc__shop">Sheffield Pottery</span><span class="shimpo-gc__amt">$40</span><span class="shimpo-gc__lbl">Gift Card</span></div>
        <div class="shimpo-gc"><span class="shimpo-gc__shop">Sheffield Pottery</span><span class="shimpo-gc__amt">$30</span><span class="shimpo-gc__lbl">Gift Card</span></div>
      </div>
    </div>

    <div class="shimpo-hero__cta">
      <a class="shimpo-hero__btn" href="{{ shop_url }}">{{ button_label }} <span aria-hidden="true">→</span></a>
      <p class="shimpo-hero__dates" style="margin:0">Offer runs <time datetime="2026-11-01">Nov 1</time> – <time datetime="2026-12-31">Dec 31</time></p>
    </div>
  </div>
</section>
{%- endif -%}