\n  @keyframes shimpo-snow-a { to { transform: translateY(200px); } }\n  @keyframes shimpo-snow-b { to { transform: translateY(320px); } }\n  @media (prefers-reduced-motion: reduce) { .shimpo-hero__snow::before, .shimpo-hero__snow::after { animation: none; } }\n</style>\n<a class=\"shimpo-hero\" href=\"/collections/shimpo-pottery-wheels\" aria-label=\"Shimpo holiday promo: get a $40 gift card with an RK-Whisper or VL-Whisper, or a $30 gift card with a VL-Lite, Nov 1 to Dec 31. Shop Shimpo wheels.\">\n  <picture>\n    <source media=\"(max-width: 719px)\" srcset=\"{{ 'shimpo-holiday-slide-mobile.jpg' | file_url }}\" width=\"800\" height=\"760\">\n    <img src=\"{{ 'shimpo-holiday-slide-desktop.jpg' | file_url }}\" width=\"1900\" height=\"560\" alt=\"Shimpo holiday promo: get a $40 Sheffield Pottery gift card with a Shimpo RK-Whisper or VL-Whisper, or a $30 gift card with a VL-Lite. Nov 1 to Dec 31.\" fetchpriority=\"high\">\n  </picture>\n  <span class=\"shimpo-hero__snow\" aria-hidden=\"true\"></span>\n</a>",
