{%- comment -%}
  Live-text promo slideshow.

  Replaces the homepage slideshow, whose slides were 1900x190 pictures with every word
  drawn into them. Here each slide is a small photo (no words in it) next to real HTML
  text: the label, the headline, the details, the price and the button. Search engines
  can index the text, it stays sharp on every screen, and you edit the words in the
  theme editor instead of making new images.

  All slides are in the page HTML (not loaded later by script), so Google sees every slide,
  not only the first one. Swiping, the dots and autoplay all use the small script at the
  bottom.

  Slide settings:
    Photo            the small image. Leave empty to use the linked product's main photo.
    Photo style      "Cover" crops a lifestyle photo to fill its space; "Product cut-out"
                     shows the whole product on the cream background.
    Product          optional. Shows that product's live price, compare-at price and
                     "Save $X", so the slide never shows an out-of-date price.
    Gift card        optional, e.g. "$50". Draws a small gift certificate over the photo.
{%- endcomment -%}
{%- liquid
  assign sid = 'lts-' | append: section.id
  assign autoplay_ms = section.settings.autoplay_seconds | times: 1000
-%}
<style>
  #{{ sid }} { --lts-cream: #fbf5ea; --lts-red: #b5202a; --lts-ink: #1d1d1d; --lts-muted: #3c3c3c;
    position: relative; background: linear-gradient(90deg, #f7efe1, var(--lts-cream) 40%, #f9f1e3);
    border-bottom: 6px solid var(--lts-red); box-shadow: inset 0 -3px 0 #e8c98a; }
  #{{ sid }} .lts__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    scrollbar-width: none; margin: 0; padding: 0; list-style: none; }
  #{{ sid }} .lts__track::-webkit-scrollbar { display: none; }
  #{{ sid }} .lts__slide { box-sizing: border-box; position: relative; flex: 0 0 100%; scroll-snap-align: start; overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 23%) minmax(0, 1fr) auto; align-items: center;
    column-gap: clamp(24px, 3vw, 56px); min-height: clamp(150px, 10vw, 220px); padding-right: clamp(20px, 2.2vw, 44px); }

  #{{ sid }} .lts__photo { position: relative; align-self: stretch; height: 100%; min-height: inherit; }
  #{{ sid }} .lts__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    -webkit-mask-image: linear-gradient(90deg, #000 55%, transparent); mask-image: linear-gradient(90deg, #000 55%, transparent); }
  #{{ sid }} .lts__photo.lts__photo--product img { inset: 0 auto 0 12%; width: auto; height: 100%; aspect-ratio: 1; object-fit: cover; mix-blend-mode: multiply;
    -webkit-mask-image: radial-gradient(closest-side, #000 62%, transparent); mask-image: radial-gradient(closest-side, #000 62%, transparent); }
  #{{ sid }} .lts__photo .lts__img--mob { display: none; }

  #{{ sid }} .lts__gc { position: absolute; right: -4%; top: 55%; width: 40%; max-width: 170px; transform: translateY(-50%) rotate(-6deg);
    padding: 7% 4% 6%; background: #fff; color: var(--lts-red); text-align: center; border-radius: 6px; container-type: inline-size;
    box-shadow: 0 0 0 2px var(--lts-red), inset 0 0 0 4px #fff, inset 0 0 0 5px var(--lts-red), 0 8px 18px rgba(0,0,0,.18); }
  #{{ sid }} .lts__gc-shop { display: block; color: #222; font: italic 600 10cqi/1.2 'Jost', sans-serif; }
  #{{ sid }} .lts__gc-amt { display: block; font: 400 28cqi/1.05 'Marcellus', serif; }
  #{{ sid }} .lts__gc-lbl { display: block; font: italic 600 10cqi/1 'Jost', sans-serif; }

  #{{ sid }} .lts__copy { padding: 14px 0; }
  #{{ sid }} .lts__eyebrow { margin: 0 0 4px; color: var(--lts-red); font: italic 600 clamp(12px, 1.05vw, 20px)/1.2 'Jost', sans-serif;
    letter-spacing: .12em; text-transform: uppercase; }
  #{{ sid }} .lts__title { margin: 0 0 6px; color: var(--lts-ink); font: 400 clamp(26px, 2.9vw, 56px)/1.05 'Marcellus', serif;
    letter-spacing: 0; text-transform: none; }
  #{{ sid }} .lts__text { margin: 0; color: var(--lts-muted); font: 500 clamp(14px, 1.1vw, 21px)/1.35 'Jost', sans-serif; }

  #{{ sid }} .lts__aside { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
  #{{ sid }} .lts__price { display: grid; grid-template-columns: auto auto; grid-template-rows: auto auto; column-gap: 12px;
    align-items: center; margin: 0; }
  #{{ sid }} .lts__now { grid-row: 1 / 3; color: var(--lts-red); font: 700 clamp(30px, 3vw, 58px)/1 'Jost', sans-serif; letter-spacing: -.02em; }
  #{{ sid }} .lts__was { color: var(--lts-muted); font: 500 clamp(14px, 1.1vw, 21px)/1.2 'Jost', sans-serif; }
  #{{ sid }} .lts__save { justify-self: start; padding: .2em .65em; border-radius: 999px; background: var(--lts-ink); color: #fff;
    font: 600 clamp(12px, .95vw, 18px)/1.3 'Jost', sans-serif; white-space: nowrap; }
  #{{ sid }} .lts__btn { display: inline-flex; align-items: center; gap: .6em; padding: .65em 1.4em; border-radius: 999px;
    background: var(--lts-red); color: #fff; text-decoration: none; white-space: nowrap;
    font: 600 clamp(15px, 1.2vw, 23px)/1.2 'Jost', sans-serif; box-shadow: 0 6px 16px rgba(181,32,42,.28); transition: transform .15s; }
  #{{ sid }} .lts__btn:hover, #{{ sid }} .lts__btn:focus-visible { transform: translateY(-2px); color: #fff; }

  #{{ sid }} .lts__dots { position: absolute; left: 50%; bottom: 8px; transform: translateX(-50%); display: flex; gap: 4px; }
  #{{ sid }} .lts__dot { width: 24px; height: 24px; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  #{{ sid }} .lts__dot::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: rgba(29,29,29,.25); transition: background .2s, transform .2s; }
  #{{ sid }} .lts__dot[aria-current="true"]::before { background: var(--lts-red); transform: scale(1.2); }

  @media (prefers-reduced-motion: reduce) { #{{ sid }} .lts__track { scroll-behavior: auto; } #{{ sid }} .lts__btn { transition: none; } }

  @media (max-width: 719px) {
    #{{ sid }} .lts__slide { display: flex; flex-direction: column; align-items: flex-start; min-height: 230px;
      padding: 14px 16px 40px; row-gap: 10px; }
    #{{ sid }} .lts__photo { position: absolute; top: 0; right: 0; bottom: 58px; width: 46%; height: auto; min-height: 0; }
    #{{ sid }} .lts__photo .lts__img--desk { display: none; }
    #{{ sid }} .lts__photo .lts__img--mob { display: block; }
    #{{ sid }} .lts__photo img { -webkit-mask-image: linear-gradient(270deg, #000 45%, transparent); mask-image: linear-gradient(270deg, #000 45%, transparent); }
    #{{ sid }} .lts__photo.lts__photo--product img { inset: 0 0 0 auto; -webkit-mask-image: radial-gradient(closest-side, #000 62%, transparent); mask-image: radial-gradient(closest-side, #000 62%, transparent); }
    #{{ sid }} .lts__gc { display: none; }
    #{{ sid }} .lts__copy { position: relative; z-index: 1; max-width: 62%; padding: 0; }
    #{{ sid }} .lts__aside { position: relative; z-index: 1; align-self: stretch; flex-direction: row; justify-content: space-between;
      align-items: flex-end; margin-top: auto; }
    #{{ sid }} .lts__btn { margin-left: auto; }
    #{{ sid }} .lts__dots { left: 16px; transform: none; bottom: 6px; }
  }
</style>

<section id="{{ sid }}" class="lts" aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}"
  data-autoplay="{% if section.settings.autoplay and section.blocks.size > 1 %}{{ autoplay_ms }}{% else %}0{% endif %}">
  <ul class="lts__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign s = block.settings
        assign p = s.product
        assign photo = s.image
        if photo == blank and p != blank
          assign photo = p.featured_image
        endif
        assign photo_mobile = s.image_mobile | default: photo
        assign link = s.link
        if link == blank and p != blank
          assign link = p.url
        endif
        assign img_loading = 'lazy'
        if forloop.first
          assign img_loading = 'eager'
        endif
        assign show_price = false
        if s.show_price and p != blank
          assign show_price = true
          assign v = p.selected_or_first_available_variant
        endif
      -%}
      <li class="lts__slide" id="{{ sid }}-{{ forloop.index }}" aria-roledescription="slide"
        aria-label="{{ forloop.index }} of {{ forloop.length }}" {{ block.shopify_attributes }}>
        <div class="lts__photo{% if s.photo_style == 'product' %} lts__photo--product{% endif %}">
          {%- if photo != blank -%}
            {{ photo | image_url: width: 600 | image_tag:
              class: 'lts__img--desk',
              widths: '300, 440, 600',
              sizes: '23vw',
              alt: photo.alt,
              loading: img_loading }}
            {{ photo_mobile | image_url: width: 400 | image_tag:
              class: 'lts__img--mob',
              widths: '200, 300, 400',
              sizes: '46vw',
              alt: photo_mobile.alt,
              loading: 'lazy' }}
          {%- endif -%}
          {%- if s.gift_card != blank -%}
            <div class="lts__gc" aria-hidden="true">
              <span class="lts__gc-shop">Sheffield Pottery</span>
              <span class="lts__gc-amt">{{ s.gift_card }}</span>
              <span class="lts__gc-lbl">Gift Certificate</span>
            </div>
          {%- endif -%}
        </div>

        <div class="lts__copy">
          {%- if s.eyebrow != blank -%}<p class="lts__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="lts__title">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.text != blank -%}<p class="lts__text">{{ s.text }}</p>{%- endif -%}
        </div>

        <div class="lts__aside">
          {%- if show_price -%}
            <p class="lts__price">
              <span class="lts__now">{{ v.price | money_without_trailing_zeros }}</span>
              {%- if v.compare_at_price > v.price -%}
                <s class="lts__was"><span class="visually-hidden">Regular price </span>{{ v.compare_at_price | money_without_trailing_zeros }}</s>
                <span class="lts__save">Save {{ v.compare_at_price | minus: v.price | money_without_trailing_zeros }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}
          {%- if s.button_label != blank and link != blank -%}
            <a class="lts__btn" href="{{ link }}">{{ s.button_label }} <span aria-hidden="true">→</span></a>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>

  {%- if section.blocks.size > 1 -%}
    <div class="lts__dots">
      {%- for block in section.blocks -%}
        <button class="lts__dot" type="button" aria-controls="{{ sid }}-{{ forloop.index }}"
          aria-label="Show slide {{ forloop.index }}: {{ block.settings.heading | escape }}"
          {% if forloop.first %}aria-current="true"{% endif %}></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('{{ sid }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    var track = root.querySelector('.lts__track');
    var slides = root.querySelectorAll('.lts__slide');
    var dots = root.querySelectorAll('.lts__dot');
    var delay = parseInt(root.dataset.autoplay, 10) || 0;
    var current = 0, timer = null, paused = false;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) delay = 0;

    function go(i) {
      current = (i + slides.length) % slides.length;
      track.scrollTo({ left: slides[current].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    }
    function mark(i) {
      current = i;
      dots.forEach(function (d, n) { d.setAttribute('aria-current', n === i ? 'true' : 'false'); });
      slides.forEach(function (s, n) { if (n === i) { s.removeAttribute('inert'); } else { s.setAttribute('inert', ''); } });
    }
    function tick() { if (!paused) go(current + 1); }
    function start() { stop(); if (delay) timer = setInterval(tick, delay); }
    function stop() { if (timer) clearInterval(timer); timer = null; }

    dots.forEach(function (d, n) { d.addEventListener('click', function () { go(n); start(); }); });
    track.addEventListener('scroll', function () {
      var i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== current) mark(i);
    }, { passive: true });
    ['mouseenter', 'focusin', 'touchstart'].forEach(function (e) { root.addEventListener(e, function () { paused = true; }, { passive: true }); });
    ['mouseleave', 'focusout'].forEach(function (e) { root.addEventListener(e, function () { paused = false; }); });
    document.addEventListener('shopify:block:select', function (e) {
      var i = Array.prototype.indexOf.call(slides, e.target);
      if (i !== -1) { paused = true; go(i); }
    });

    mark(0);
    start();
  })();
</script>

{% schema %}
{
  "name": "Live-text slideshow",
  "tag": "div",
  "class": "shopify-section--full-width",
  "settings": [
    { "type": "text", "id": "label", "label": "Name read out by screen readers", "default": "Current promotions" },
    { "type": "checkbox", "id": "autoplay", "label": "Change slides automatically", "default": true },
    { "type": "range", "id": "autoplay_seconds", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "A photo with no words in it, about 440 x 180. Leave empty to use the product's main photo." },
        { "type": "image_picker", "id": "image_mobile", "label": "Phone photo (optional)", "info": "A taller crop for phones, about 350 x 245. Leave empty to reuse the photo above." },
        { "type": "select", "id": "photo_style", "label": "Photo style", "default": "cover",
          "options": [ { "value": "cover", "label": "Cover (lifestyle photo)" }, { "value": "product", "label": "Product cut-out" } ] },
        { "type": "text", "id": "gift_card", "label": "Gift card amount (optional)", "info": "e.g. $50. Draws a gift certificate over the photo." },
        { "type": "text", "id": "eyebrow", "label": "Small label" },
        { "type": "text", "id": "heading", "label": "Headline" },
        { "type": "text", "id": "text", "label": "Details" },
        { "type": "product", "id": "product", "label": "Product (optional)" },
        { "type": "checkbox", "id": "show_price", "label": "Show the product's live price", "default": false },
        { "type": "url", "id": "link", "label": "Button link", "info": "Leave empty to link to the product." },
        { "type": "text", "id": "button_label", "label": "Button text", "default": "Shop now" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Live-text slideshow",
      "blocks": [
        { "type": "slide", "settings": { "eyebrow": "Pottery wheel sale", "heading": "BTH Andromeda D3", "text": "Whisper-quiet 1 HP direct drive · 5-year warranty · free $50 gift certificate", "photo_style": "product", "gift_card": "$50", "show_price": true, "button_label": "Shop now" } },
        { "type": "slide", "settings": { "eyebrow": "Kiln packages", "heading": "Everything you need to fire", "text": "Kiln, vent and furniture kit in one order. Touchscreen upgrades available.", "button_label": "Shop kiln packages" } },
        { "type": "slide", "settings": { "eyebrow": "Schools, camps and universities", "heading": "Equip your clay classroom", "text": "Clay, wheels, glazes and kilns. Bids and quotes welcome.", "button_label": "Explore for schools" } },
        { "type": "slide", "settings": { "eyebrow": "Automatic glaze discounts", "heading": "Save up to 20% on glaze", "text": "Mix and match 6 or more glazes and underglazes: 5% off, up to 20% at 48.", "button_label": "Shop pottery glaze" } }
      ]
    }
  ]
}
{% endschema %}
